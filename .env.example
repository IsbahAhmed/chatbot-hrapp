# --- LLM (ChatOllama = local Ollama; GPU is configured on Ollama, not in this app) ---
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-coder:6.7b
# Optional: push all layers to GPU (-1), or set a layer count
OLLAMA_NUM_GPU=-1
# OLLAMA_NUM_THREAD=8

# AMD Windows: quit Ollama, run scripts/start-ollama-amd.ps1, then pull your model.
# Or set user env vars OLLAMA_VULKAN=1 and OLLAMA_GPU_OVERIDE=vulkan before starting Ollama.

# Cloud fallback (no local GPU):
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# --- Embeddings for Chroma retrieval ---
# huggingface = CPU/DirectML in Python | ollama = same AMD GPU path as chat via Ollama
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
# If switching embedding provider or model, re-run: python seed_docs.py

# huggingface-only options:
# EMBEDDING_PROVIDER=huggingface
# CHROMA_EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBED_DEVICE=cpu

CHROMA_COLLECTION=hr_policies
RELEVANCE_THRESHOLD=0.1
HISTORY_WINDOW=10
PORT=8000
